{
  "name": "proofstate-js",
  "version": "0.1.0-rc.1",
  "description": "ProofState JavaScript / TypeScript SDK",
  "author": "ProofState",
  "repository": "https://github.com/JSOCIT-Inc/proofstate-js",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check:format": "prettier --check \"**/*.{ts,js,json,md}\" --log-level error --experimental-cli",
    "check:lint": "eslint \"packages/*/src/**/*.ts\" --quiet",
    "check:type": "tsc -b --noEmit",
    "precommit:check": "turbo run check:lint check:type check:format --continue=never",
    "docs": "pnpm build && typedoc --options ./typedoc.config.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project=unit",
    "test:unit:watch": "vitest --project=unit",
    "test:integration": "pnpm run build && vitest run --project=integration",
    "test:integration:watch": "pnpm run build && vitest --project=integration",
    "test:e2e": "pnpm run build && vitest run --project=e2e",
    "lint": "eslint \"packages/*/src/**/*.ts\" --quiet",
    "lint:fix": "eslint \"packages/*/src/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\" --experimental-cli",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\" --log-level error --experimental-cli",
    "typecheck": "tsc -b --noEmit",
    "generated-docs:sanitize": "node scripts/sanitize-generated-api-docs.mjs",
    "generated-docs:check": "node scripts/sanitize-generated-api-docs.mjs --check",
    "release:pack": "pnpm build && node scripts/release-npm.mjs --pack",
    "ci": "pnpm build && pnpm test:unit && pnpm test:integration && pnpm lint && pnpm typecheck && pnpm generated-docs:check && pnpm format:check",
    "clean": "pnpm -r run clean && rm -rf packages/*/dist && rm -f packages/*/tsconfig.tsbuildinfo",
    "nuke": "pnpm clean && rm -rf node_modules && rm -rf packages/*/node_modules && pnpm install",
    "prepare": "husky"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^2",
    "@ai-sdk/openai": "4.0.0",
    "@eslint/js": "^9.32.0",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.1.4",
    "@langchain/openai": "^1.2.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@types/mustache": "^4.2.6",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.39.0",
    "ai": "7.0.2",
    "autoevals": "^0.0.131",
    "dotenv": "^17.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "mustache": "^4.2.0",
    "nanoid": "^5.1.5",
    "npm": "11.16.0",
    "openai": "^5.0.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "turbo": "^2.8.13",
    "typedoc": "^0.28.9",
    "typescript": "^5.3.0",
    "vitest": "^3.2.6",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "resolutions": {
    "@grpc/proto-loader@0.8.1>protobufjs": "7.6.4",
    "ml-spectra-processing": "14.14.0"
  },
  "packageManager": "pnpm@10.33.0"
}
