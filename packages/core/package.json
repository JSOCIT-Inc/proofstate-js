{
  "name": "@proofstate/core",
  "version": "5.11.1",
  "description": "Core functions and utilities for ProofState packages",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "author": "ProofState",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JSOCIT-Inc/proofstate-js.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
