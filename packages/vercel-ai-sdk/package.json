{
  "name": "@proofstate/vercel-ai-sdk",
  "version": "0.1.0-rc.2",
  "description": "ProofState integration for Vercel AI SDK v7",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "author": "ProofState",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JSOCIT-Inc/proofstate-js.git",
    "directory": "packages/vercel-ai-sdk"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ai-sdk/otel": "^1.0.44",
    "@proofstate/core": "workspace:^"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "ai": ">=7.0.0 <8"
  },
  "devDependencies": {
    "ai": "7.0.44"
  },
  "publishConfig": {
    "access": "public"
  }
}
